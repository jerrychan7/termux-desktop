#!/data/data/com.termux/files/usr/bin/python3
"""Entry point for the desk command.

Run this file from a Termux shell:

    ./desk setup
    ./desk start

The file finds the Python package in two places: next to itself, which is
where a checkout keeps it, and in ../lib/termux-desktop/src, which is where
desk install puts it below $PREFIX/bin.

The shebang above is the only path in this repository that is written as a
Termux path: the entry point must start before PREFIX is available. Every
other path comes from PREFIX and HOME.
"""

import os
import sys

entry_directory = os.path.dirname(os.path.realpath(__file__))
package_candidates = (
    os.path.join(entry_directory, "src"),
    os.path.join(os.path.dirname(entry_directory), "lib", "termux-desktop", "src"),
)
for package_directory in package_candidates:
    if os.path.isdir(os.path.join(package_directory, "termux_desk")):
        if package_directory not in sys.path:
            sys.path.insert(0, package_directory)
        break

from termux_desk.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
